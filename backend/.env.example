# Local development defaults are used if these are omitted.
# For Render, configure persistent paths and secrets in the Render dashboard.
DATABASE_PATH=./data/vendor_onboarding.sqlite3
VENDORFLOW_UPLOAD_DIR=./private_uploads
VENDORFLOW_AUTH_SECRET=replace-with-a-long-random-secret
VENDOR_FERNET_KEY=generate-with-python-cryptography-fernet
VENDORFLOW_REVIEWER_SETUP_KEY=replace-with-a-one-time-setup-secret
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional AI extraction. OCR still works without these values.
# The provider must expose an OpenAI-compatible /chat/completions endpoint.
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional malware scanning via ClamAV daemon. If unset, uploads are explicitly marked UNSCANNED.
# When configured but unavailable, uploads are rejected (fail closed).
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=8

# Optional deployment mode. Enables HSTS on HTTPS deployments.
VENDORFLOW_ENV=production
